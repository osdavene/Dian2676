APP_NAME="Simulador DIAN 2676"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Base de Datos PostgreSQL ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dian2676_db
DB_USERNAME=postgres
DB_PASSWORD=
DB_CHARSET=utf8
DB_SCHEMA=public

# En despliegues AWS / Railway se puede usar la URL directa de la BD:
# DATABASE_URL=postgresql://usuario:clave@host-rds:5432/dian2676_db

# ─── Sesiones y Cache ────────────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ─── AWS S3 (Opcional para adjuntos de estudio) ────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Correo Electrónico (Brevo API HTTPS - Puerto 443) ────────────────
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS="no-reply@dian2676.duckdns.org"
MAIL_FROM_NAME="DIAN 2676 Concurso"

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
